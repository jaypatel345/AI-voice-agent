# ---- Server ----
PORT=8080

# ---- Sarvam AI (STT + TTS) ----
# https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key
STT_MODEL=saaras:v4
STT_LANGUAGE_CODE=en-IN
TTS_MODEL=bulbul:v3
TTS_SPEAKER=shubh
TTS_SAMPLE_RATE=24000

# ---- LLM: Gemini on Vertex AI (asia-south1 / Mumbai) ----
# Requires `gcloud auth application-default login` locally,
# or a service-account JSON with GOOGLE_APPLICATION_CREDENTIALS set.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=asia-south1
GEMINI_MODEL=gemini-3.1-flash-lite
USE_VERTEX_AI=true
# Gemini generation location. Use `global` if your project does not serve
# Gemini from the asia-south1 regional endpoint; embeddings stay regional.
GEMINI_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ---- Qdrant (Vector DB) ----
# Local: http://localhost:6333 . Managed: your Qdrant Cloud cluster URL.
# Keep the cluster in the same region as the app (asia-south1) — a
# cross-region cluster adds ~1s to every cold retrieval.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=voice_kb
# Embedding model used to precompute vectors (see server/rag/ingest.js)
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768

# ---- Redis (cache) ----
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600

# ---- RAG constraints ----
RAG_TOP_K=2
RAG_CONTEXT_TOKEN_LIMIT=1000
# Retrieval budget. ~150 ms is enough for a same-region Qdrant; a remote /
# cross-region cluster needs more (prod runs 1500 with Qdrant in us-west-1).
RAG_RETRIEVAL_TIMEOUT_MS=150

# ---- Memory ----
SHORT_TERM_TURNS=3
