# ---- Server ----
PORT=8080

# ---- Sarvam AI (STT + TTS) ----
# https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key
STT_MODEL=saaras:v4
STT_LANGUAGE_CODE=en-IN
TTS_MODEL=bulbul:v3
TTS_SPEAKER=shubh
TTS_SAMPLE_RATE=24000

# ---- LLM: Gemini on Vertex AI ----
# Requires `gcloud auth application-default login` locally,
# or a service-account JSON with GOOGLE_APPLICATION_CREDENTIALS set.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-3.1-flash-lite
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ---- Qdrant (Vector DB) ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=voice_kb
# Embedding model used to precompute vectors (see server/rag/ingest.js)
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768

# ---- Redis (cache) ----
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600

# ---- RAG constraints ----
RAG_TOP_K=2
RAG_CONTEXT_TOKEN_LIMIT=1000
RAG_RETRIEVAL_TIMEOUT_MS=150

# ---- Memory ----
SHORT_TERM_TURNS=3
