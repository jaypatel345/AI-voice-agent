    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "openai": "^7.10.0",
    "redis": "^4.7.0",
    "sarvamai": "^0.1.9",
    "uuid": "^9.0.1",
    "ws": "^8.18.0"
